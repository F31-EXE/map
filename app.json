{
  "expo": {
    "name": "GrimMap",
    "slug": "tacmap",
    "version": "1.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.f31exe.tacmap",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Нужно, чтобы показывать вашу позицию на карте и передавать её команде.",
        "NSMotionUsageDescription": "Компас для направления взгляда на карте."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141816",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.f31exe.tacmap",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "grimmap",
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Нужно, чтобы показывать вашу позицию на карте и передавать её команде."
        }
      ],
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Нужно, чтобы выбрать фото для аватара.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "owner": "f31",
    "extra": {
      "eas": {
        "projectId": "b5e15505-6f4f-4130-bbb7-4beed43f3a31"
      }
    }
  }
}
