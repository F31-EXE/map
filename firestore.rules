rules_version = '2';

// Data model:
//   teamCodes/{code}                 -> { teamId }            join code lookup
//   teams/{teamId}                   -> { name, code, ownerId, color, createdAt, recordingId?, pinned? }
//   teams/{teamId}/members/{uid}     -> { callsign, role, status?, canCommand?, joinCode, lat, lng, heading, accuracy, updatedAt }
//     pinned = { id, text, callsign, uid, at }: chat message pinned by a commander
//   teams/{teamId}/markers/{id}      -> { kind, label, lat, lng, createdBy, createdByName, createdAt, relayedBy? }
//   teams/{teamId}/avatars/{uid}     -> { data, updatedAt }   small JPEG data URI
//   teams/{teamId}/messages/{id}    -> { uid, callsign, text, createdAt, relayedBy? }   team chat
//   teams/{teamId}/recordings/{id}  -> { name, startedAt, endedAt, startedBy }; tracks/{uid} -> { points }
//   sides/{sideId}                   -> { name, code, ownerId, createdAt }   several squads under one side commander
//   sideCodes/{code}                 -> { sideId }
// A squad joins a side when its leader writes { sideId, sideCode } into the team doc.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function memberPath(teamId, uid) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(uid);
    }
    function isMember(teamId) {
      return signedIn() && exists(memberPath(teamId, request.auth.uid));
    }
    function isOwner(teamId) {
      return signedIn() && get(teamPath(teamId)).data.ownerId == request.auth.uid;
    }
    // Team creator, or a member the creator granted command rights to.
    function canCommand(teamId) {
      return isOwner(teamId)
        || (isMember(teamId) && get(memberPath(teamId, request.auth.uid)).data.get('canCommand', false) == true);
    }
    function sidePath(sideId) {
      return /databases/$(database)/documents/sides/$(sideId);
    }
    function isSideOwner(sideId) {
      return signedIn() && sideId is string && get(sidePath(sideId)).data.ownerId == request.auth.uid;
    }
    // Commander of the side this squad is attached to.
    function isSideCommanderOf(teamId) {
      let t = get(teamPath(teamId)).data;
      return isSideOwner(t.get('sideId', null));
    }
    // 4 side commander, 3 squad creator, 2 member with command rights, 1 fighter.
    // Mirrors src/lib/ranks.ts.
    function rank(teamId, uid) {
      let t = get(teamPath(teamId)).data;
      let sideId = t.get('sideId', null);
      let m = memberPath(teamId, uid);
      return sideId != null && get(sidePath(sideId)).data.ownerId == uid ? 4
        : t.ownerId == uid ? 3
        : exists(m) && get(m).data.get('canCommand', false) == true ? 2
        : 1;
    }
    function isOrderKind(kind) {
      return kind in ['order-move', 'order-attack', 'order-defend'];
    }
    // Field is unchanged, or is the old list plus the caller's uid.
    function votedOnlyAsSelf(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      return after == before
        || (after.toSet() == before.toSet().union([request.auth.uid].toSet()) && after.size() <= 50);
    }
    function validColor(c) {
      return c is string && c.matches('^#[0-9A-Fa-f]{6}$');
    }
    function validProfile(d) {
      return d.callsign is string
        && d.callsign.size() <= 24
        && (!('role' in d) || (d.role is string && d.role.size() <= 20))
        && (!('status' in d) || d.status in ['alive', 'dead', 'afk']);
    }
    function validPinned(p) {
      return p == null
        || (p.text is string && p.text.size() <= 500
          && p.callsign is string && p.callsign.size() <= 24
          && p.id is string && p.uid is string);
    }

    match /teamCodes/{code} {
      // Only direct lookups by a known code; listing codes is not allowed.
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(teamPath(request.resource.data.teamId)).data.ownerId == request.auth.uid
        && getAfter(teamPath(request.resource.data.teamId)).data.code == code;
      allow update, delete: if false;
    }

    match /sideCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(sidePath(request.resource.data.sideId)).data.ownerId == request.auth.uid
        && getAfter(sidePath(request.resource.data.sideId)).data.code == code;
      allow update, delete: if false;
    }

    match /sides/{sideId} {
      // Squad leaders read the side's name after attaching; ids are unguessable.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name.size() <= 40;
      allow delete: if false;
    }

    match /teams/{teamId} {
      allow get: if isMember(teamId) || isSideOwner(resource.data.get('sideId', null));
      // The side commander lists squads with where('sideId', '==', mySide).
      allow list: if isSideOwner(resource.data.get('sideId', null));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && (!('color' in request.resource.data) || validColor(request.resource.data.color));
      // The creator may rename the team, change its color and attach it to a side (with
      // that side's code) or detach it; code and owner are fixed.
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color', 'sideId', 'sideCode'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && (!('color' in request.resource.data) || validColor(request.resource.data.color))
          && (request.resource.data.get('sideId', null) == null
            || request.resource.data.get('sideCode', null) == get(sidePath(request.resource.data.sideId)).data.code))
        // Commanders start and stop movement recording and pin chat messages.
        || (canCommand(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recordingId', 'pinned'])
          && validPinned(request.resource.data.get('pinned', null)))
        // The side commander may drop a squad from the side, and nothing else.
        || (isSideOwner(resource.data.get('sideId', null))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sideId', 'sideCode'])
          && request.resource.data.sideId == null
          && request.resource.data.sideCode == null)
      );
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(teamId) || isSideCommanderOf(teamId);
        // Joining requires knowing the team's code; nobody grants themselves command rights.
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.joinCode == getAfter(teamPath(teamId)).data.code
          && request.resource.data.get('canCommand', false) == false
          && validProfile(request.resource.data);
        allow update: if signedIn() && (
          // Own profile and position.
          (uid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['joinCode', 'canCommand'])
            && validProfile(request.resource.data))
          // The creator grants or revokes command rights, and nothing else.
          || (isOwner(teamId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canCommand'])
            && request.resource.data.canCommand is bool)
          // Commanders assign roles and set the status of anyone below them.
          || (canCommand(teamId)
            && rank(teamId, request.auth.uid) > rank(teamId, uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status'])
            && validProfile(request.resource.data))
        );
        // Leave, or be removed by the team creator.
        allow delete: if signedIn() && (uid == request.auth.uid || isOwner(teamId));
      }

      match /markers/{markerId} {
        allow read: if isMember(teamId) || isSideCommanderOf(teamId);
        allow create: if request.resource.data.kind is string
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 40
          && (!('points' in request.resource.data)
            || (request.resource.data.points is list && request.resource.data.points.size() <= 40))
          && !('staleVotes' in request.resource.data)
          && !('doneVotes' in request.resource.data)
          // A respawn can come with its departure schedule, from a commander only.
          && (!('wave' in request.resource.data)
            || (canCommand(teamId)
              && request.resource.data.kind in ['respawn', 'deadzone']
              && !('relayedBy' in request.resource.data)
              && request.resource.data.wave.keys().hasOnly(['every', 'start'])
              && request.resource.data.wave.every is number
              && request.resource.data.wave.every >= 60000
              && request.resource.data.wave.every <= 10800000
              && request.resource.data.wave.start is number))
          && (
            (request.resource.data.createdBy == request.auth.uid
              && !('relayedBy' in request.resource.data)
              && (
                // Squad members; orders only from the squad's commanders.
                (isMember(teamId) && (!isOrderKind(request.resource.data.kind) || canCommand(teamId)))
                // The side commander sends orders to squad commanders.
                || (isSideCommanderOf(teamId)
                  && isOrderKind(request.resource.data.kind)
                  && request.resource.data.get('audience', null) == 'commanders')
              ))
            // Gateway: a member uploads a squadmate's marker heard over Bluetooth. Orders
            // only if their author may give them; side orders never travel this way.
            || (isMember(teamId)
              && request.resource.data.get('relayedBy', null) == request.auth.uid
              && request.resource.data.createdBy is string
              && exists(memberPath(teamId, request.resource.data.createdBy))
              && !('audience' in request.resource.data)
              && (!isOrderKind(request.resource.data.kind) || rank(teamId, request.resource.data.createdBy) >= 2))
          );
        // Voting: a squad member adds themselves to staleVotes or doneVotes, nothing else.
        allow update: if (isMember(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staleVotes', 'doneVotes'])
          && votedOnlyAsSelf('staleVotes')
          && votedOnlyAsSelf('doneVotes'))
          // Commanders set the departure schedule on respawn / dead-zone markers.
          || (canCommand(teamId)
            && resource.data.kind in ['respawn', 'deadzone']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wave'])
            && (request.resource.data.wave == null
              || (request.resource.data.wave.keys().hasOnly(['every', 'start'])
                && request.resource.data.wave.every is number
                && request.resource.data.wave.every >= 60000
                && request.resource.data.wave.every <= 10800000
                && request.resource.data.wave.start is number)))
          // The author drags their own marker to a new spot.
          || (isMember(teamId)
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lat', 'lng'])
            && request.resource.data.lat is number
            && request.resource.data.lng is number);
        // Chain of command: your own markers, or those of anyone strictly below you.
        allow delete: if (isMember(teamId) || isSideCommanderOf(teamId))
          && (resource.data.createdBy == request.auth.uid
            || rank(teamId, request.auth.uid) > rank(teamId, resource.data.createdBy));
      }

      // Movement recordings: commanders start/stop, everyone appends to their own track.
      match /recordings/{recId} {
        allow read: if isMember(teamId) || isSideCommanderOf(teamId);
        allow create: if canCommand(teamId)
          && request.resource.data.startedBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60;
        allow update: if canCommand(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt']);
        allow delete: if isOwner(teamId);

        match /tracks/{uid} {
          allow read: if isMember(teamId) || isSideCommanderOf(teamId);
          allow write: if isMember(teamId)
            && uid == request.auth.uid
            && request.resource.data.points is list
            && request.resource.data.points.size() <= 20000
            && request.resource.data.callsign is string
            && request.resource.data.callsign.size() <= 24;
        }
      }

      // Team chat. Ids are generated on the phone so relayed copies collapse into one.
      match /messages/{messageId} {
        allow read: if isMember(teamId);
        // Own messages; or a gateway phone uploading a squadmate's message it received
        // over Bluetooth (marked with relayedBy).
        allow create: if isMember(teamId)
          && (request.resource.data.uid == request.auth.uid
            || (request.resource.data.get('relayedBy', null) == request.auth.uid
              && request.resource.data.uid is string
              && exists(memberPath(teamId, request.resource.data.uid))))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.callsign is string
          && request.resource.data.callsign.size() <= 24;
        allow update: if false;
        allow delete: if isMember(teamId) && resource.data.uid == request.auth.uid;
      }

      match /avatars/{uid} {
        allow read: if isMember(teamId);
        allow write: if isMember(teamId)
          && uid == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() < 60000
          && request.resource.data.data.matches('^data:image/(jpeg|png);base64,.*');
        allow delete: if signedIn() && (uid == request.auth.uid || isOwner(teamId));
      }
    }
  }
}
