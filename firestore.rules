rules_version = '2';

// Data model:
//   teamCodes/{code}                 -> { teamId }            join code lookup
//   teams/{teamId}                   -> { name, code, ownerId, createdAt }
//   teams/{teamId}/members/{uid}     -> { callsign, color, joinCode, lat, lng, heading, accuracy, updatedAt }
//   teams/{teamId}/markers/{id}      -> { kind, label, lat, lng, createdBy, createdByName, createdAt }
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function isMember(teamId) {
      return signedIn() && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    match /teamCodes/{code} {
      // Only direct lookups by a known code; listing codes is not allowed.
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(teamPath(request.resource.data.teamId)).data.ownerId == request.auth.uid
        && getAfter(teamPath(request.resource.data.teamId)).data.code == code;
      allow update, delete: if false;
    }

    match /teams/{teamId} {
      allow get: if isMember(teamId);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.code == resource.data.code;
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(teamId);
        // Joining requires knowing the team's code.
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.joinCode == getAfter(teamPath(teamId)).data.code
          && request.resource.data.callsign is string
          && request.resource.data.callsign.size() <= 24;
        allow update: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.joinCode == resource.data.joinCode
          && request.resource.data.callsign is string
          && request.resource.data.callsign.size() <= 24;
        // Leave, or be removed by the team owner.
        allow delete: if signedIn()
          && (uid == request.auth.uid || get(teamPath(teamId)).data.ownerId == request.auth.uid);
      }

      match /markers/{markerId} {
        allow read: if isMember(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.kind is string
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 40;
        allow update: if false;
        allow delete: if isMember(teamId);
      }
    }
  }
}
