rules_version = '2';

// Data model:
//   teamCodes/{code}                 -> { teamId }            join code lookup
//   teams/{teamId}                   -> { name, code, ownerId, color, createdAt, recordingId?, pinned? }
//   teams/{teamId}/members/{uid}     -> { callsign, role, status?, canCommand?, joinCode, lat, lng, heading, accuracy, updatedAt, range? }
//     pinned = { id, text, callsign, uid, at }: chat message pinned by a commander
//   teams/{teamId}/markers/{id}      -> { kind, label, lat, lng, createdBy, createdByName, createdAt, relayedBy? }
//   teams/{teamId}/avatars/{uid}     -> { data, updatedAt }   small JPEG data URI
//   teams/{teamId}/photos/{id}       -> { data, createdBy, createdAt }   photo marker picture
//   teams/{teamId}/maps/{id}         -> { name, format, size, parts, createdBy, createdByName, createdAt }; parts/{nn} -> { i, data, createdBy }
//   teams/{teamId}/messages/{id}    -> { uid, callsign, text, createdAt, relayedBy? }   team chat
//   teams/{teamId}.briefing          -> { text, time, points, by, byName, at }   commanders; members.briefRead = at
//   teams/{teamId}/recordings/{id}  -> { name, startedAt, endedAt, startedBy }; tracks/{uid} -> { points }
//   sides/{sideId}                   -> { name, code, ownerId, createdAt }   several squads under one side commander
//   sideCodes/{code}                 -> { sideId }
//   sides/{sideId}                   + { gameId, gameCode } when the side plays in a game; + { claim } when a game
//                                      tech made it for a commander to take over
// A squad joins a side when its leader writes { sideId, sideCode } into the team doc.
//   games/{gameId}                   -> { name, ownerId, techCode, sideCode, createdAt, tickets? }   a big game
//   gameCodes/{code}                 -> { gameId, kind: 'tech' | 'side' }
//   games/{g}/techs/{uid}            -> { callsign, code, lat?, lng?, updatedAt }   game techs (organizers), equal rights
//   games/{g}/sides/{sideId}         -> { name, color, tickets }   the side as the game sees it (score board)
//   games/{g}/players/{uid}          -> { sideId, teamId, callsign, pts, deaths }   self-registered, chain checked
//   games/{g}/markers/{id}           -> game markers placed by techs (control zones, flags, zones…)
// A side joins a game when its commander writes { gameId, gameCode } into the side doc.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function teamPath(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function memberPath(teamId, uid) {
      return /databases/$(database)/documents/teams/$(teamId)/members/$(uid);
    }
    function isMember(teamId) {
      return signedIn() && exists(memberPath(teamId, request.auth.uid));
    }
    function isOwner(teamId) {
      return signedIn() && get(teamPath(teamId)).data.ownerId == request.auth.uid;
    }
    // Team creator, or a member the creator granted command rights to.
    function canCommand(teamId) {
      return isOwner(teamId)
        || (isMember(teamId) && get(memberPath(teamId, request.auth.uid)).data.get('canCommand', false) == true);
    }
    function sidePath(sideId) {
      return /databases/$(database)/documents/sides/$(sideId);
    }
    function isSideOwner(sideId) {
      return signedIn() && sideId is string && get(sidePath(sideId)).data.ownerId == request.auth.uid;
    }
    // Commander of the side this squad is attached to.
    function isSideCommanderOf(teamId) {
      let t = get(teamPath(teamId)).data;
      return isSideOwner(t.get('sideId', null));
    }
    function gamePath(gameId) {
      return /databases/$(database)/documents/games/$(gameId);
    }
    // Game techs (organizers): each has a doc under the game; all have the same rights.
    function isTech(gameId) {
      return signedIn() && gameId is string
        && exists(/databases/$(database)/documents/games/$(gameId)/techs/$(request.auth.uid));
    }
    function isPlayer(gameId) {
      return signedIn() && gameId is string
        && exists(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid));
    }
    function inGame(gameId) {
      return isTech(gameId) || isPlayer(gameId);
    }
    // A tech of the game this side plays in.
    function isTechOfSide(sideId) {
      return sideId is string && isTech(get(sidePath(sideId)).data.get('gameId', null));
    }
    function isTechOfTeam(teamId) {
      return isTechOfSide(get(teamPath(teamId)).data.get('sideId', null));
    }
    // Everyone above the squad: its side commander and the game's techs.
    function oversees(teamId) {
      return isSideCommanderOf(teamId) || isTechOfTeam(teamId);
    }
    // 4 side commander, 3 squad creator, 2 member with command rights, 1 fighter.
    // Mirrors src/lib/ranks.ts.
    function rank(teamId, uid) {
      let t = get(teamPath(teamId)).data;
      let sideId = t.get('sideId', null);
      let m = memberPath(teamId, uid);
      return sideId != null && get(sidePath(sideId)).data.ownerId == uid ? 4
        : t.ownerId == uid ? 3
        : exists(m) && get(m).data.get('canCommand', false) == true ? 2
        : 1;
    }
    // Control zone (`hotzone` marker), as in src/lib/hotzone.ts validZone().
    function validZone(z) {
      return z is map
        && z.keys().hasOnly(['r', 'hot', 'every', 'start', 'seed'])
        && z.r is number && z.r >= 50 && z.r <= 5000
        && z.hot is number && z.hot >= 10 && z.hot <= z.r
        && z.every is number && z.every >= 60000 && z.every <= 3600000
        && z.start is number
        && z.seed is number;
    }
    function isOrderKind(kind) {
      return kind in ['order-move', 'order-attack', 'order-defend'];
    }
    // Field is unchanged, or is the old list plus the caller's uid.
    function votedOnlyAsSelf(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      return after == before
        || (after.toSet() == before.toSet().union([request.auth.uid].toSet()) && after.size() <= 50);
    }
    function validColor(c) {
      return c is string && c.matches('^#[0-9A-Fa-f]{6}$');
    }
    function validProfile(d) {
      return d.callsign is string
        && d.callsign.size() <= 24
        && (!('role' in d) || (d.role is string && d.role.size() <= 20))
        && (!('status' in d) || d.status in ['alive', 'dead', 'afk'])
        && (!('faction' in d) || d.faction == null || (d.faction is int && d.faction >= 0 && d.faction < 6))
        && (!('pts' in d) || (d.pts is map && d.pts.size() <= 50))
        && (!('range' in d) || (d.range is number && d.range > 0 && d.range <= 2000))
        && (!('battery' in d) || d.battery == null || (d.battery is number && d.battery >= 0 && d.battery <= 100))
        && (!('charging' in d) || d.charging is bool)
        && (!('radioBattery' in d) || d.radioBattery == null
          || (d.radioBattery is number && d.radioBattery >= 0 && d.radioBattery <= 101))
        && (!('briefRead' in d) || d.briefRead == null || d.briefRead is number)
        && (!('tag' in d) || d.tag == null || (d.tag is string && d.tag.size() <= 5));
    }
    // Squad briefing: written by commanders as themselves.
    function validBriefing(b) {
      return b == null
        || (b is map && b.keys().hasOnly(['text', 'time', 'points', 'by', 'byName', 'at'])
          && b.text is string && b.text.size() <= 2000
          && (b.time == null || (b.time is string && b.time.size() <= 20))
          && b.points is list && b.points.size() <= 30
          && b.by == request.auth.uid
          && b.byName is string && b.byName.size() <= 24
          && b.at is number);
    }
    // Team game: up to six teams of { name, color } on the squad doc.
    function validFactions(f) {
      return f == null || (f is list && f.size() <= 6);
    }
    // Snail grid origin: NW corner of square А1.
    function validGrid(g) {
      return g == null
        || (g is map && g.keys().hasOnly(['lat', 'lng'])
          && g.lat is number && g.lng is number
          && g.lat >= -90 && g.lat <= 90 && g.lng >= -180 && g.lng <= 180);
    }
    function validPinned(p) {
      return p == null
        || (p.text is string && p.text.size() <= 500
          && p.callsign is string && p.callsign.size() <= 24
          && p.id is string && p.uid is string);
    }

    match /teamCodes/{code} {
      // Only direct lookups by a known code; listing codes is not allowed.
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(teamPath(request.resource.data.teamId)).data.ownerId == request.auth.uid
        && getAfter(teamPath(request.resource.data.teamId)).data.code == code;
      allow update, delete: if false;
    }

    match /sideCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(sidePath(request.resource.data.sideId)).data.ownerId == request.auth.uid
        && getAfter(sidePath(request.resource.data.sideId)).data.code == code;
      allow update, delete: if false;
    }

    match /sides/{sideId} {
      // Squad leaders read the side's name after attaching; ids are unguessable.
      allow get: if signedIn();
      // Game techs list the sides of their game.
      allow list: if isTech(resource.data.get('gameId', null));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        // A tech makes sides right inside the game (with a claim code for its commander).
        && (request.resource.data.get('gameId', null) == null
          || (isTech(request.resource.data.gameId)
            && request.resource.data.gameCode == get(gamePath(request.resource.data.gameId)).data.sideCode));
      allow update: if signedIn() && (
        // The commander renames the side, or joins it to a game with the game's side code / leaves.
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'gameId', 'gameCode', 'claim'])
          && request.resource.data.name.size() <= 40
          && (request.resource.data.get('gameId', null) == null
            || request.resource.data.get('gameCode', null) == get(gamePath(request.resource.data.gameId)).data.sideCode))
        // Taking command of a side a tech made: knowing its claim code.
        || (resource.data.get('claim', null) != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'claim', 'claimedWith'])
          && request.resource.data.ownerId == request.auth.uid
          && request.resource.data.claimedWith == resource.data.claim
          && request.resource.data.claim == null)
        // A tech drops a side from the game.
        || (isTech(resource.data.get('gameId', null))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gameId', 'gameCode'])
          && request.resource.data.gameId == null)
      );
      allow delete: if false;
    }

    match /gameCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn()
        && getAfter(gamePath(request.resource.data.gameId)).data.ownerId == request.auth.uid
        && (getAfter(gamePath(request.resource.data.gameId)).data.techCode == code
          || getAfter(gamePath(request.resource.data.gameId)).data.sideCode == code);
      allow update, delete: if false;
    }

    match /games/{gameId} {
      // Commanders read the game's name after joining; ids are unguessable.
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.techCode is string
        && request.resource.data.sideCode is string;
      allow update: if isTech(gameId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'tickets', 'match', 'tiebreak'])
        && request.resource.data.name.size() <= 60
        && request.resource.data.get('tiebreak', 'draw') in ['draw', 'time']
        // The match clock: started by a tech, the same countdown on every phone.
        && (request.resource.data.get('match', null) == null
          || (request.resource.data.match.keys().hasOnly(['start', 'minutes', 'stoppedAt'])
            && request.resource.data.match.start is number
            && request.resource.data.match.minutes is int
            && request.resource.data.match.minutes >= 1 && request.resource.data.match.minutes <= 1440))
        && (request.resource.data.get('tickets', null) == null
          || (request.resource.data.tickets is int && request.resource.data.tickets >= 0 && request.resource.data.tickets <= 100000));
      allow delete: if false;

      // Techs: the creator, and whoever knows the tech code. Same rights for all.
      match /techs/{uid} {
        allow read: if inGame(gameId);
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.callsign is string && request.resource.data.callsign.size() <= 24
          // getAfter: the creator adds themselves in the same batch that creates the game.
          && (getAfter(gamePath(gameId)).data.ownerId == uid
            || request.resource.data.code == getAfter(gamePath(gameId)).data.techCode);
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['callsign', 'lat', 'lng', 'heading', 'updatedAt'])
          && request.resource.data.callsign.size() <= 24;
        // Leave, or be removed by the game's creator.
        allow delete: if signedIn() && (uid == request.auth.uid || get(gamePath(gameId)).data.ownerId == request.auth.uid);
      }

      // The game's view of each side: name, color, ticket adjustments. Techs and the
      // side's own commander write it.
      match /sides/{sideId} {
        allow read: if inGame(gameId);
        allow create, update: if (isTech(gameId)
            || (signedIn() && get(sidePath(sideId)).data.ownerId == request.auth.uid
              && getAfter(sidePath(sideId)).data.get('gameId', null) == gameId))
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && validColor(request.resource.data.color)
          && (!('tickets' in request.resource.data) || request.resource.data.tickets is int);
        allow delete: if isTech(gameId);
      }

      // Players register themselves; the chain fighter → squad → side → game is checked.
      match /players/{uid} {
        allow read: if inGame(gameId);
        // Own doc before registering (it may not exist yet).
        allow get: if signedIn() && uid == request.auth.uid;
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.callsign is string && request.resource.data.callsign.size() <= 24
          && request.resource.data.sideId is string
          && get(sidePath(request.resource.data.sideId)).data.get('gameId', null) == gameId
          && (
            // A fighter of a squad attached to that side.
            (request.resource.data.teamId is string
              && exists(memberPath(request.resource.data.teamId, uid))
              && get(teamPath(request.resource.data.teamId)).data.get('sideId', null) == request.resource.data.sideId)
            // The side's commander.
            || (request.resource.data.teamId == null
              && get(sidePath(request.resource.data.sideId)).data.ownerId == uid)
          )
          && (!('pts' in request.resource.data) || request.resource.data.pts is map)
          && (!('deaths' in request.resource.data) || request.resource.data.deaths is int);
        // Own score: points per control zone, deaths for tickets; and the territory
        // sector the fighter stood in during the last match minute (the tech counts them).
        allow update: if signedIn() && uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['callsign', 'pts', 'deaths', 'cell', 'cellAt'])
          && request.resource.data.pts is map && request.resource.data.pts.size() <= 50
          && request.resource.data.deaths is int;
        allow delete: if signedIn() && (uid == request.auth.uid || isTech(gameId));
      }

      // Game markers: techs place control zones, flags, territory sectors and zones;
      // players capture flags. Sectors change hands only by the techs' count.
      match /markers/{markerId} {
        allow read: if inGame(gameId);
        allow create, delete: if isTech(gameId);
        allow update: if isTech(gameId)
          || (isPlayer(gameId)
            && resource.data.kind == 'flag'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'log'])
            && request.resource.data.owner == get(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid)).data.sideId
            && request.resource.data.log.size() == resource.data.get('log', []).size() + 1
            && request.resource.data.log[request.resource.data.log.size() - 1].s == request.resource.data.owner);
      }
    }

    match /teams/{teamId} {
      allow get: if isMember(teamId) || isSideOwner(resource.data.get('sideId', null))
        || isTechOfSide(resource.data.get('sideId', null));
      // The side commander (and the game's techs) list squads with where('sideId', '==', side).
      allow list: if isSideOwner(resource.data.get('sideId', null)) || isTechOfSide(resource.data.get('sideId', null));
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && (!('color' in request.resource.data) || validColor(request.resource.data.color));
      // The creator may rename the team, change its color and attach it to a side (with
      // that side's code) or detach it; code and owner are fixed.
      allow update: if signedIn() && (
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'color', 'sideId', 'sideCode', 'factions'])
          && validFactions(request.resource.data.get('factions', null))
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && (!('color' in request.resource.data) || validColor(request.resource.data.color))
          && (request.resource.data.get('sideId', null) == null
            || request.resource.data.get('sideCode', null) == get(sidePath(request.resource.data.sideId)).data.code))
        // Commanders start and stop movement recording, pin chat messages, place
        // the snail grid's square А1 and write the briefing.
        || (canCommand(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['recordingId', 'pinned', 'grid', 'briefing'])
          && validPinned(request.resource.data.get('pinned', null))
          && validGrid(request.resource.data.get('grid', null))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['briefing'])
            || validBriefing(request.resource.data.briefing)))
        // The side commander may drop a squad from the side, and nothing else.
        || (isSideOwner(resource.data.get('sideId', null))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sideId', 'sideCode'])
          && request.resource.data.sideId == null
          && request.resource.data.sideCode == null)
      );
      allow delete: if false;

      match /members/{uid} {
        allow read: if isMember(teamId) || oversees(teamId);
        // Joining requires knowing the team's code; nobody grants themselves command rights.
        allow create: if signedIn()
          && uid == request.auth.uid
          && request.resource.data.joinCode == getAfter(teamPath(teamId)).data.code
          && request.resource.data.get('canCommand', false) == false
          && validProfile(request.resource.data);
        allow update: if signedIn() && (
          // Own profile and position.
          (uid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['joinCode', 'canCommand', 'faction'])
            && validProfile(request.resource.data))
          // The creator grants or revokes command rights, and nothing else.
          || (isOwner(teamId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['canCommand'])
            && request.resource.data.canCommand is bool)
          // The creator, as game master, puts players into teams.
          || (isOwner(teamId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['faction'])
            && validProfile(request.resource.data))
          // Commanders assign roles and set the status of anyone below them.
          || (canCommand(teamId)
            && rank(teamId, request.auth.uid) > rank(teamId, uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status'])
            && validProfile(request.resource.data))
        );
        // Leave, or be removed by the team creator.
        allow delete: if signedIn() && (uid == request.auth.uid || isOwner(teamId));
      }

      match /markers/{markerId} {
        allow read: if isMember(teamId) || oversees(teamId);
        allow create: if request.resource.data.kind is string
          && request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 40
          && (!('points' in request.resource.data)
            || (request.resource.data.points is list && request.resource.data.points.size() <= 40))
          && !('staleVotes' in request.resource.data)
          && !('doneVotes' in request.resource.data)
          // A respawn can come with its departure schedule, from a commander only.
          && (!('wave' in request.resource.data)
            || (canCommand(teamId)
              && request.resource.data.kind in ['respawn', 'deadzone']
              && !('relayedBy' in request.resource.data)
              && request.resource.data.wave.keys().hasOnly(['every', 'start'])
              && request.resource.data.wave.every is number
              && request.resource.data.wave.every >= 60000
              && request.resource.data.wave.every <= 10800000
              && request.resource.data.wave.start is number))
          // Control zone with a moving hot zone: commanders only, never relayed.
          && (request.resource.data.kind != 'hotzone'
            || (canCommand(teamId)
              && !('relayedBy' in request.resource.data)
              && validZone(request.resource.data.zone)))
          && (!('zone' in request.resource.data) || request.resource.data.kind == 'hotzone')
          && (
            (request.resource.data.createdBy == request.auth.uid
              && !('relayedBy' in request.resource.data)
              && (
                // Squad members; orders only from the squad's commanders.
                (isMember(teamId) && (!isOrderKind(request.resource.data.kind) || canCommand(teamId)))
                // The side commander sends orders to squad commanders.
                || (isSideCommanderOf(teamId)
                  && isOrderKind(request.resource.data.kind)
                  && request.resource.data.get('audience', null) == 'commanders')
              ))
            // Gateway: a member uploads a squadmate's marker heard over Bluetooth. Orders
            // only if their author may give them; side orders never travel this way.
            || (isMember(teamId)
              && request.resource.data.get('relayedBy', null) == request.auth.uid
              && request.resource.data.createdBy is string
              && exists(memberPath(teamId, request.resource.data.createdBy))
              && !('audience' in request.resource.data)
              && (!isOrderKind(request.resource.data.kind) || rank(teamId, request.resource.data.createdBy) >= 2))
          );
        // Voting: a squad member adds themselves to staleVotes or doneVotes, nothing else.
        allow update: if (isMember(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['staleVotes', 'doneVotes'])
          && votedOnlyAsSelf('staleVotes')
          && votedOnlyAsSelf('doneVotes'))
          // Commanders set the departure schedule on respawn / dead-zone markers.
          || (canCommand(teamId)
            && resource.data.kind in ['respawn', 'deadzone']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['wave'])
            && (request.resource.data.wave == null
              || (request.resource.data.wave.keys().hasOnly(['every', 'start'])
                && request.resource.data.wave.every is number
                && request.resource.data.wave.every >= 60000
                && request.resource.data.wave.every <= 10800000
                && request.resource.data.wave.start is number)))
          // Commanders change the control zone / hot zone settings.
          || (canCommand(teamId)
            && resource.data.kind == 'hotzone'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['zone'])
            && validZone(request.resource.data.zone))
          // The author drags their own marker to a new spot.
          || (isMember(teamId)
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lat', 'lng'])
            && request.resource.data.lat is number
            && request.resource.data.lng is number);
        // Chain of command: your own markers, or those of anyone strictly below you.
        allow delete: if (isMember(teamId) || isSideCommanderOf(teamId))
          && (resource.data.createdBy == request.auth.uid
            || rank(teamId, request.auth.uid) > rank(teamId, resource.data.createdBy));
      }

      // Movement recordings: commanders start/stop, everyone appends to their own track.
      match /recordings/{recId} {
        allow read: if isMember(teamId) || isSideCommanderOf(teamId);
        allow create: if canCommand(teamId)
          && request.resource.data.startedBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60;
        allow update: if canCommand(teamId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['endedAt']);
        allow delete: if isOwner(teamId);

        match /tracks/{uid} {
          allow read: if isMember(teamId) || isSideCommanderOf(teamId);
          // The fighter deletes their own track ("delete my data" in Settings).
          allow delete: if isMember(teamId) && uid == request.auth.uid;
          allow create, update: if isMember(teamId)
            && uid == request.auth.uid
            && request.resource.data.points is list
            && request.resource.data.points.size() <= 20000
            && request.resource.data.callsign is string
            && request.resource.data.callsign.size() <= 24;
        }
      }

      // Team chat. Ids are generated on the phone so relayed copies collapse into one.
      match /messages/{messageId} {
        allow read: if isMember(teamId);
        // Own messages; or a gateway phone uploading a squadmate's message it received
        // over Bluetooth (marked with relayedBy).
        allow create: if isMember(teamId)
          && (request.resource.data.uid == request.auth.uid
            || (request.resource.data.get('relayedBy', null) == request.auth.uid
              && request.resource.data.uid is string
              && exists(memberPath(teamId, request.resource.data.uid))))
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.callsign is string
          && request.resource.data.callsign.size() <= 24;
        allow update: if false;
        allow delete: if isMember(teamId) && resource.data.uid == request.auth.uid;
      }

      // Polygon maps shared with the squad; the file is base64 in numbered parts.
      match /maps/{mapId} {
        allow read: if isMember(teamId) || isSideCommanderOf(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 80
          && request.resource.data.format in ['kmz', 'kml', 'gpx', 'geojson']
          && request.resource.data.parts is int
          && request.resource.data.parts >= 1
          && request.resource.data.parts <= 10;
        allow delete: if isMember(teamId)
          && (resource.data.createdBy == request.auth.uid
            || rank(teamId, request.auth.uid) > rank(teamId, resource.data.createdBy));

        match /parts/{partId} {
          allow read: if isMember(teamId) || isSideCommanderOf(teamId);
          allow create: if isMember(teamId)
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.i is int
            && request.resource.data.data is string
            && request.resource.data.data.size() <= 800000;
          allow delete: if isMember(teamId)
            && (resource.data.createdBy == request.auth.uid
              || rank(teamId, request.auth.uid) > rank(teamId, resource.data.createdBy));
        }
      }

      // Pictures of photo markers: compressed JPEG data URIs, one per doc.
      match /photos/{photoId} {
        allow read: if isMember(teamId) || isSideCommanderOf(teamId);
        allow create: if isMember(teamId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() < 400000
          && request.resource.data.data.matches('^data:image/jpeg;base64,.*');
        allow delete: if isMember(teamId)
          && (resource.data.createdBy == request.auth.uid
            || rank(teamId, request.auth.uid) > rank(teamId, resource.data.createdBy));
      }

      match /avatars/{uid} {
        allow read: if isMember(teamId);
        allow write: if isMember(teamId)
          && uid == request.auth.uid
          && request.resource.data.data is string
          && request.resource.data.data.size() < 60000
          && request.resource.data.data.matches('^data:image/(jpeg|png);base64,.*');
        allow delete: if signedIn() && (uid == request.auth.uid || isOwner(teamId));
      }
    }
  }
}
